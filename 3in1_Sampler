#include <Arduino.h>

#define MIC1 34
#define MIC2 35
#define MIC3 33

#define SAMPLE_RATE 2400
#define SAMPLE_DELAY_US (1000000 / SAMPLE_RATE)

typedef struct {
  uint8_t m1;
  uint8_t m2;
  uint8_t m3;
} SamplePair;

QueueHandle_t sampleQueue;

// ── SAMPLING TASK (MASTER CLOCK) ─────────────────
void samplingTask(void *parameter) {
  unsigned long last = micros();

  while (true) {
    if (micros() - last >= SAMPLE_DELAY_US) {
      last += SAMPLE_DELAY_US;


      uint16_t s1 = analogRead(MIC1);
      uint16_t s2 = analogRead(MIC2);
      uint16_t s3 = analogRead(MIC3);

      SamplePair sample;
      sample.m1 = s1 >> 4;
      sample.m2 = s2 >> 4;
      sample.m3 = s3 >> 4;

      // push to queue
      xQueueSend(sampleQueue, &sample, 0);
    }
  }
}

// ── SERIAL TASK ──────────────────────────────────
void serialTask(void *parameter) {
  SamplePair sample;

  while (true) {
    if (xQueueReceive(sampleQueue, &sample, portMAX_DELAY)) {
      // send both together → same "frame"
      Serial.write(0xFF);  // sync
      Serial.write(0xAA);
      Serial.write(sample.m1);
      Serial.write(sample.m2);
      Serial.write(sample.m3);
    }
  }
}

// ── SETUP ────────────────────────────────────────
void setup() {
  Serial.begin(921600);
  analogReadResolution(12);

  sampleQueue = xQueueCreate(64, sizeof(SamplePair));

  // Sampling on core 0 (priority high)
  xTaskCreatePinnedToCore(samplingTask, "Sampling", 2048, NULL, 2, NULL, 0);

  // Serial on core 1
  xTaskCreatePinnedToCore(serialTask, "Serial", 2048, NULL, 1, NULL, 1);
}

void loop() {}
